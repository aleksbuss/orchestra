# === Orchestra Configuration ===

# Model provider keys — set at least ONE (any provider works; Orchestra points
# its model slots at the first key it finds). You can also paste a key into the
# API Keys Vault in Settings instead of using this file.
#
# These lines are commented out ON PURPOSE. Orchestra treats any non-empty value
# as a real credential, so an uncommented placeholder such as `sk-...` makes it
# believe that provider is configured and keeps the model slots pointed at it.
# Uncomment ONLY the provider(s) you actually hold a key for, and replace the
# value with the real key.
# OPENROUTER_API_KEY=sk-or-...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...

# Tavily Search (optional - for web search; same rule: uncomment with a real key)
# TAVILY_API_KEY=tvly-...

# Bearer token for POST /api/external/message. Leave it EMPTY: the installers
# generate a random value, and while it is empty the endpoint answers 503
# (disabled). That endpoint is exempt from session auth, so this token is the
# only thing protecting it — never ship, commit or reuse a well-known value.
EXTERNAL_API_TOKEN=

# App auth session secret — REQUIRED in production; refusal-to-start otherwise.
# Generate a long random value (DO NOT commit it):
#   openssl rand -base64 48
# Then paste the output below. Each deployment must have its OWN secret —
# never reuse this value across environments or copy it from a tutorial.
ORCHESTRA_AUTH_SECRET=

# Telegram integration (optional; UI can auto-configure from bot token only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DEFAULT_PROJECT_ID=

# Docker runtime bind settings
APP_BIND_HOST=127.0.0.1
APP_PORT=3000

# Optional Docker runtime cache/temp paths (inside container).
# Defaults are defined in docker-compose.yml and usually do not need overrides.
# APP_TMP_DIR=/app/data/tmp
# PLAYWRIGHT_BROWSERS_PATH=/app/data/ms-playwright
# NPM_CONFIG_CACHE=/app/data/npm-cache
# XDG_CACHE_HOME=/app/data/.cache

# Optional CLI OAuth credential file overrides (for codex-cli / gemini-cli provider auth checks).
# If unset, Orchestra auto-discovers files in common home directories.
# Useful when Orchestra runs under a different user than the CLI login user.
# CODEX_AUTH_FILE=/home/node/.codex/auth.json
# GEMINI_OAUTH_CREDS_FILE=/home/node/.gemini/oauth_creds.json
# GEMINI_SETTINGS_FILE=/home/node/.gemini/settings.json

APP_BASE_URL=http://localhost:3000

# Optional agent timeouts (milliseconds). Defaults shown; see
# docs/references/security-patterns.md for what each one actually bounds.
# The cascade budget and its per-attempt deadline are a PAIR — never set only one.
# ORCHESTRA_CALL_DEADLINE_MS=240000
# ORCHESTRA_FINAL_ANSWER_ATTEMPT_DEADLINE_MS=25000
# ORCHESTRA_FALLBACK_CASCADE_BUDGET_MS=50000
# ORCHESTRA_TOOL_RETRY_DEADLINE_MS=60000
# ORCHESTRA_TOOL_RETRY_CANDIDATE_DEADLINE_MS=20000
