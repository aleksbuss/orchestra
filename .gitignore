# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
/test-results
/playwright-report

# eval suite results (run output — cases themselves are tracked)
/evals/results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# data directory (chats, memory, projects)
/data/

# local full-data/ backups (storage/backup.ts) — sibling of data/, never committed
/data-backups/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.py[cod]

# Build data-symlink guard manifest (crash-recovery breadcrumb)
.next-data-symlink-guard.json

# E2E isolated data dir (PM #62 — never the real data/)
.e2e-data/
# E2E isolated backup dir (PM #78 — never the real data-backups/)
.e2e-data-backups/
# Clean-boot server (PM #103): its own empty data dir, backup dir, and Next
# build dir — two `next dev` processes cannot share `.next/`.
.e2e-clean-data/
.e2e-clean-data-backups/
# ANY custom Next build dir, not just the clean-boot one. `ORCHESTRA_NEXT_DIST_DIR`
# is how you run a second server without racing `.next/`, and each new value left
# an untracked build directory behind. Be aware it also makes Next write
# `"<dir>/types/**/*.ts"` into the TRACKED `tsconfig.json` include array — that
# part cannot be gitignored, so `git checkout -- tsconfig.json` after using one.
/.next-*/
.e2e-clean-boot-manifest.json
scratch.ts
/scratch/
playwright-report/

# Claude Code local settings
.claude/
logs/

# generated benchmark output
scripts/benchmark-report.md

# Stryker mutation testing — heavy generated reports + sandboxes (keep the config + the STRENGTHEN-TESTS guide)
.stryker-tmp/
stryker.log
reports/stryker/*.json
reports/stryker/*.html

# graphify knowledge-graph index — 33 MB of generated output, rebuilt by `graphify update .`
# (AST-only, no API cost). CLAUDE.md documents it as a local tool, not a repo artefact.
graphify-out/

# Editor-local config
.obsidian/
